-- Local client-side cache, mirroring what the relay itself persists per room (PROTOCOL.md §3/§4):
-- this is a cache the sync client rebuilds its view from, never a second source of truth - the
-- signed log entries and op envelopes it stores are byte-identical to what's on the wire.

CREATE TABLE log_entries (
  room        BLOB NOT NULL,
  idx         INTEGER NOT NULL,
  entry_cbor  BLOB NOT NULL,
  rts         INTEGER NOT NULL,
  PRIMARY KEY (room, idx)
);

insertLogEntry:
INSERT OR REPLACE INTO log_entries (room, idx, entry_cbor, rts) VALUES (?, ?, ?, ?);

logEntriesFrom:
SELECT * FROM log_entries WHERE room = ? AND idx >= ? ORDER BY idx ASC;

maxLogIndex:
SELECT MAX(idx) FROM log_entries WHERE room = ?;

CREATE TABLE ops (
  room          BLOB NOT NULL,
  cursor        INTEGER NOT NULL,
  op_id         BLOB NOT NULL,
  device        BLOB NOT NULL,
  seq           INTEGER NOT NULL,
  envelope_cbor BLOB NOT NULL,
  PRIMARY KEY (room, cursor)
);

insertOp:
INSERT OR REPLACE INTO ops (room, cursor, op_id, device, seq, envelope_cbor) VALUES (?, ?, ?, ?, ?, ?);

opsAfter:
SELECT * FROM ops WHERE room = ? AND cursor > ? ORDER BY cursor ASC;

maxOpsCursor:
SELECT MAX(cursor) FROM ops WHERE room = ?;

-- Per-room sync progress: the last log index and ops cursor this client has durably applied -
-- so `pull()` knows where to resume from after a restart.
CREATE TABLE cursors (
  room           BLOB NOT NULL PRIMARY KEY,
  last_log_index INTEGER NOT NULL,
  last_ops_cursor INTEGER NOT NULL
);

upsertCursor:
INSERT OR REPLACE INTO cursors (room, last_log_index, last_ops_cursor) VALUES (?, ?, ?);

cursorFor:
SELECT * FROM cursors WHERE room = ?;

-- Per-device last-seen seq within a room - lets the client detect its own gaps locally before
-- even asking the relay (PROTOCOL.md §4.1: "seq uint per-device monotonic, starts at 1 (gap
-- detection)"), and is also exactly the "seq vector" a Snapshot's inner format needs (§4.4).
CREATE TABLE device_seq (
  room   BLOB NOT NULL,
  device BLOB NOT NULL,
  seq    INTEGER NOT NULL,
  PRIMARY KEY (room, device)
);

upsertDeviceSeq:
INSERT OR REPLACE INTO device_seq (room, device, seq) VALUES (?, ?, ?);

deviceSeqsFor:
SELECT * FROM device_seq WHERE room = ?;

-- Locally-created ops not yet confirmed by the relay. local_order is a client-assigned monotonic
-- counter (independent of lamport/seq, which the relay cares about) purely so push() drains them
-- in creation order. envelope_cbor is replaced in place (same local_order) when stale_epoch
-- re-encryption rewraps a pending op under a new epoch key.
-- body_cbor is the PLAINTEXT OpBody (§4.2), never sent over the wire from here - it's the only
-- way stale_epoch retry can re-encrypt a pending op under a new key: an AEAD ciphertext can't be
-- "re-keyed" without its plaintext, so storing only the already-encrypted envelope (as an earlier
-- version of this schema did) would make re-encryption impossible. envelope_cbor is the current
-- best-effort signed-and-encrypted form, ready to push as-is; epoch/nonce there always match the
-- epoch/nonce columns below, kept in sync by replaceOutboxEnvelope.
CREATE TABLE outbox (
  room          BLOB NOT NULL,
  local_order   INTEGER NOT NULL,
  epoch         INTEGER NOT NULL,
  seq           INTEGER NOT NULL,
  lamport       INTEGER NOT NULL,
  nonce         BLOB NOT NULL,
  body_cbor     BLOB NOT NULL,
  envelope_cbor BLOB NOT NULL,
  PRIMARY KEY (room, local_order)
);

insertOutbox:
INSERT INTO outbox (room, local_order, epoch, seq, lamport, nonce, body_cbor, envelope_cbor) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

replaceOutboxEnvelope:
UPDATE outbox SET epoch = ?, nonce = ?, envelope_cbor = ? WHERE room = ? AND local_order = ?;

outboxFor:
SELECT * FROM outbox WHERE room = ? ORDER BY local_order ASC;

deleteOutboxEntry:
DELETE FROM outbox WHERE room = ? AND local_order = ?;

maxOutboxLocalOrder:
SELECT MAX(local_order) FROM outbox WHERE room = ?;

-- PROTOCOL.md §3.5: the inviteSecret lives only in the share link's URL fragment, never sent to
-- any server - but the admin device that MINTED the invite is the only place it ever existed, and
-- §3.5 requires "Admins MUST re-upload envelopes of all active invites after every epochRotate",
-- possibly long after the original creation, even across process restarts. There's nothing to
-- re-derive it from (unlike epoch keys, which can always be re-unwrapped from the log), so it has
-- to be persisted here.
CREATE TABLE invite_secrets (
  room      BLOB NOT NULL,
  invite_id BLOB NOT NULL,
  secret    BLOB NOT NULL,
  PRIMARY KEY (room, invite_id)
);

insertInviteSecret:
INSERT OR REPLACE INTO invite_secrets (room, invite_id, secret) VALUES (?, ?, ?);

inviteSecretsFor:
SELECT * FROM invite_secrets WHERE room = ?;

deleteInviteSecret:
DELETE FROM invite_secrets WHERE room = ? AND invite_id = ?;
